<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharaccount_dcr_form" model="ir.ui.view">
        <field name="name">pharaccount.dcr.form</field>
        <field name="model">pharaccount.dcr</field>
        <field name="arch" type="xml">
            <form string="Pharmacy DCR">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="pharmacy_id"/>
                        <field name="pharmacy_record_type_id"/>
                        <field name="pharmacy_level_id"/>
                        <field name="state_id"/>
                        <field name="mobile"/>
                        <field name="telephone"/>
                        <field name="geo_province"/>
                        <field name="geo_city"/>
                        <field name="address"/>
                        <field name="is_important"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pharaccount_dcr_list" model="ir.ui.view">
        <field name="name">pharaccount.dcr.list</field>
        <field name="model">pharaccount.dcr</field>
        <field name="arch" type="xml">
            <list string="Pharmacy DCR">
                <field name="name"/>
                <field name="pharmacy_id"/>
                <field name="telephone"/>
                <field name="geo_city"/>
            </list>
        </field>
    </record>
</odoo>
