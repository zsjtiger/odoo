<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_pharaccount">
        <field name="name">Pharmacy Account</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- A user can belong to several groups (res.users.group_ids). -->
    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_pharaccount"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">View and edit pharmacy accounts.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_pharaccount"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="comment">Also delete pharmacy accounts. Import and export permission bits are reserved.</field>
    </record>

    <record id="group_config" model="res.groups">
        <field name="name">Configuration</field>
        <field name="privilege_id" ref="res_groups_privilege_pharaccount"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="comment">Edit record types and picklists.</field>
    </record>
</odoo>
