<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- pharmacy_level picklist, as in vrux (A/B/C/D) -->
        <record id="picklist_pharmacy_level" model="pharaccount.picklist">
            <field name="name">pharmacy_level</field>
            <field name="label">药店级别</field>
        </record>
        <record id="pharmacy_level_a" model="pharaccount.picklist.value">
            <field name="picklist_id" ref="picklist_pharmacy_level"/>
            <field name="name">A</field>
            <field name="label">A级</field>
            <field name="sequence">1</field>
        </record>
        <record id="pharmacy_level_b" model="pharaccount.picklist.value">
            <field name="picklist_id" ref="picklist_pharmacy_level"/>
            <field name="name">B</field>
            <field name="label">B级</field>
            <field name="sequence">2</field>
        </record>
        <record id="pharmacy_level_c" model="pharaccount.picklist.value">
            <field name="picklist_id" ref="picklist_pharmacy_level"/>
            <field name="name">C</field>
            <field name="label">C级</field>
            <field name="sequence">3</field>
        </record>
        <record id="pharmacy_level_d" model="pharaccount.picklist.value">
            <field name="picklist_id" ref="picklist_pharmacy_level"/>
            <field name="name">D</field>
            <field name="label">D级</field>
            <field name="sequence">4</field>
        </record>

        <!-- record types: parent pharma, children as in vrux -->
        <record id="record_type_pharma" model="pharaccount.record.type">
            <field name="name">pharma</field>
            <field name="label">药店</field>
            <field name="sequence">1</field>
        </record>
        <record id="record_type_pharmacy_chain_head" model="pharaccount.record.type">
            <field name="name">pharmacy_chain_head</field>
            <field name="label">连锁总店</field>
            <field name="parent_id" ref="record_type_pharma"/>
            <field name="sequence">10</field>
        </record>
        <record id="record_type_pharmacy_chain_branch" model="pharaccount.record.type">
            <field name="name">pharmacy_chain_branch</field>
            <field name="label">连锁门店</field>
            <field name="parent_id" ref="record_type_pharma"/>
            <field name="sequence">20</field>
        </record>
        <record id="record_type_pharmacy_monomer" model="pharaccount.record.type">
            <field name="name">pharmacy_monomer</field>
            <field name="label">单体药店</field>
            <field name="parent_id" ref="record_type_pharma"/>
            <field name="sequence">30</field>
        </record>
    </data>
</odoo>
