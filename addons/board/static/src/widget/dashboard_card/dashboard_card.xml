<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="snow_mdm.DashBoardCardFieldWidget" t-inherit="snow_mdm.DashBoardWidget" owl="1">
        <xpath expr="//div[@class='snow_mdm_dashboard_chart_container']/t[1]" position="after">

            <t t-if="!_showLoading">
                <div class="snow_mdm_dashboard_card_container">
                    <t t-foreach="_dashboardData" t-as="_db" t-key="_db.name">
                        <div class="snow_mdm_dashboard_card" t-on-click="_onItemClick" t-att-data-data-name="_db.name">
                            <h4 class="snow_mdm_dashboard_card_title">
                                <t t-esc="_db.name"/>
                            </h4>
                            <h5 class="snow_mdm_dashboard_card_value">
                                <t t-esc="_fromatInteger(_db.value)"/>
                            </h5>
                        </div>
                    </t>
                </div>
            </t>

        </xpath>
    </t>
</templates>
