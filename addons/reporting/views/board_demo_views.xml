    <record id="board_demo_view_bar" model="ir.ui.view">
        <field name="name">reporting.demo.bar.form</field>
        <field name="model">reporting.demo</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="chart_bar" widget="board_dashboard_bar" options="{'direction': 'vertical'}"/>
                </group>
            </form>
        </field>
    </record>
