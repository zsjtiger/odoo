<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="web_studio.FieldDetailPanel">
    <aside class="o_web_studio_field_panel d-flex flex-column p-4 h-100 overflow-auto">
        <div class="d-flex align-items-center mb-3">
            <h4 class="m-0 me-auto o_web_studio_field_panel_title" t-out="this.props.field.label"/>
            <button type="button" class="btn-close" aria-label="Close" t-on-click="() => this.props.onClose()"/>
        </div>

        <div class="mb-3">
            <label class="form-label" for="o_web_studio_field_panel_label">Field Label</label>
            <input id="o_web_studio_field_panel_label" class="form-control o_web_studio_field_label"
                t-att-value="this.state.label"
                t-on-input="this.onLabelInput"/>
        </div>
        <div class="mb-3">
            <label class="form-label" for="o_web_studio_field_panel_name">API Name</label>
            <input id="o_web_studio_field_panel_name" class="form-control" readonly="1"
                t-att-value="this.props.field.name"/>
        </div>
        <div class="mb-3">
            <label class="form-label" for="o_web_studio_field_panel_type">Data Type</label>
            <input id="o_web_studio_field_panel_type" class="form-control" readonly="1"
                t-att-value="this.props.field.typeLabel"/>
        </div>
        <div class="mb-3">
            <label class="form-label" for="o_web_studio_field_panel_help">Field Help</label>
            <textarea id="o_web_studio_field_panel_help" class="form-control o_web_studio_field_help" rows="3"
                t-on-input="this.onHelpInput"><t t-esc="this.state.help"/></textarea>
        </div>
        <div class="form-check mb-4">
            <input id="o_web_studio_field_panel_required" type="checkbox" class="form-check-input o_web_studio_field_required"
                t-att-checked="this.state.required"
                t-att-disabled="!this.props.field.isCustom"
                t-on-change="this.onRequiredChange"/>
            <label class="form-check-label" for="o_web_studio_field_panel_required">Required</label>
        </div>

        <div class="d-flex gap-2 mt-auto">
            <button type="button" class="btn btn-primary o_web_studio_save_field"
                t-att-disabled="!this.canSave" t-on-click="this.save">Save</button>
            <button t-if="this.props.field.isCustom" type="button" class="btn btn-outline-danger o_web_studio_delete_field"
                t-on-click="this.remove">Delete</button>
        </div>
        <p t-if="!this.props.field.isCustom" class="text-muted small mt-3 mb-0">
            Standard fields can be renamed and documented. Their other properties are defined by their module.
        </p>
    </aside>
</t>

</templates>
