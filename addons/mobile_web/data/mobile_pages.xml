            <field name="sequence">2</field>
        </record>
        <record id="schedule_page_schedule_page_action_rel" model="mobile_web.mobile.page.actions">
            <field name="name">Schedule</field>
            <field name="mobile_page" ref="mobile_web.schedule_page"/>
            <field name="ir_action" ref="mobile_web.schedule_page_action"/>
            <field name="svg_icon_href">#crossnow-icon-TabSchedule</field>
            <field name="sequence">3</field>
        </record>
        <record id="schedule_page_user_my_page_action_rel" model="mobile_web.mobile.page.actions">
