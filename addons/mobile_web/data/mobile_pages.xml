<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 手机端页面 -->
    <data noupdate="1">
        <!-- 主页 -->
        <record id="home_page" model="mobile_web.mobile.page">
            <field name="name">Home Page</field>
            <field name="page_component_id">mobile_page.home_page</field>
        </record>

        <record id="home_page_action" model="ir.actions.mobile_page">
            <field name="name">Mobile Web Home Page Action</field>
            <field name="type">ir.actions.mobile_page</field>
            <field name="path">home</field>
            <field name="binding_mobile_page" ref="mobile_web.home_page"/>
        </record>

        <!-- 待办页 -->
        <record id="todo_page" model="mobile_web.mobile.page">
            <field name="name">To do</field>
            <field name="page_component_id">mobile_page.todo_page</field>
        </record>

        <record id="todo_page_action" model="ir.actions.mobile_page">
            <field name="name">Mobile Web TODO Page Action</field>
            <field name="type">ir.actions.mobile_page</field>
            <field name="path">todo</field>
            <field name="binding_mobile_page" ref="mobile_web.todo_page"/>
        </record>

        <!-- 日程页 -->
        <record id="schedule_page" model="mobile_web.mobile.page">
            <field name="name">Schedule</field>
            <field name="page_component_id">mobile_page.schedule_page</field>
        </record>

        <record id="schedule_page_action" model="ir.actions.mobile_page">
            <field name="name">Mobile Web Schedule Page Action</field>
            <field name="type">ir.actions.mobile_page</field>
            <field name="path">schedule</field>
            <field name="binding_mobile_page" ref="mobile_web.schedule_page"/>
        </record>

        <!-- 我的 -->
        <record id="user_my_page" model="mobile_web.mobile.page">
            <field name="name">Me</field>
            <field name="page_component_id">mobile_page.user_my_page</field>
        </record>

        <record id="user_my_page_action" model="ir.actions.mobile_page">
            <field name="name">Mobile Web UserMy Page Action</field>
            <field name="type">ir.actions.mobile_page</field>
            <field name="path">my</field>
            <field name="binding_mobile_page" ref="mobile_web.user_my_page"/>
        </record>
    </data>

