            <field name="mobile_page" ref="mobile_web.home_page"/>
            <field name="ir_action" ref="mobile_web.home_page_action"/>
            <field name="svg_icon_href">#crossnow-icon-TabHome</field>
            <field name="sequence">1</field>
        </record>
        <record id="home_page_todo_page_action_rel" model="mobile_web.mobile.page.actions">
            <field name="name">To do</field>
            <field name="mobile_page" ref="mobile_web.home_page"/>
            <field name="ir_action" ref="mobile_web.todo_page_action"/>
