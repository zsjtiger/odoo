<?xml version="1.0" encoding="UTF-8"?>
<crossnow>
    <data>
        <record id="view_my_submission_tree" model="ir.ui.view">
            <field name="name">snow.workflow.execution.tree</field>
            <field name="model">snow.workflow.execution</field>
            <field name="arch" type="xml">
                <tree create="0" delete="0" edit="1" export_xlsx="false" default_order="create_date desc">
                    <field name="task_name" string="task name"/>
                    <field name="create_date" string="create date"/>
                    <field name="object_name" string="approval type"/>
                    <field name="status_name" string="status name"/>
                    <field name="submitter_name" string="submitter"/>
                    <button name="dynamic_redirect" type="object" string="detail" icon="fa-external-link"/>
                </tree>
            </field>
        </record>

        <record id="view_my_submission_kanban" model="ir.ui.view">
            <field name="name">snow.workflow.execution.kanban</field>
            <field name="model">snow.workflow.execution</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" create="0" edit="0" delete="0" default_order="submit_date desc">
                    <field name="task_name" string="task name" m-layout="title"/>
                    <field name="object_name" string="approval type" m-layout="subtitle"/>
                    <field name="create_date" string="create date" m-layout="middleLeft"/>
                    <field name="status_name" string="status name" m-layout="status"/>
                    <field name="submitter_name" string="submitter" m-layout="middleRight"/>
                    <button name="dynamic_redirect" type="object" string="detail" icon="fa-external-link"/>
                </kanban>
            </field>
        </record>


        <record id="action_my_submission_act" model="ir.actions.act_window">
            <field name="name">my raised list</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">snow.workflow.execution</field>
            <field name="view_mode">tree,kanban</field>
            <field name="view_ids" eval="[(5,0,0),
            (0,0,{'view_id':ref('view_my_submission_tree'),'view_mode':'tree'}),
            (0,0,{'view_id':ref('view_my_submission_kanban'),'view_mode':'kanban'})]">
            </field>
            <field name="context">{"_type": "own_approval"}</field>
        </record>

    </data>
</crossnow>