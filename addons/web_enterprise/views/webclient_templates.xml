<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="webclient_login" inherit_id="web.login_layout">
        <xpath expr="//t[@t-call='web.frontend_layout']" position="attributes">
            <attribute name="body_classname.f">o_home_menu_background</attribute>
            <attribute name="login_card_classes.f">rounded-0 shadow-sm bg-white</attribute>
        </xpath>
    </template>

    <template id="webclient_bootstrap" inherit_id="web.webclient_bootstrap">
        <xpath expr="//meta[@name='theme-color']" position="replace">
            <meta name="theme-color" t-att-content="'#242733' if color_scheme == 'dark' else '#714B67'"/>
        </xpath>
        <xpath expr="//t[@t-call-assets='web.assets_web'][@t-css='false']" position="after">
            <t t-if="request.env['ir.http'].is_odoo_mobile_app()">
                <t t-call-assets="web_enterprise.assets_mobile_app" t-css="false"/>
            </t>
        </xpath>
    </template>
</odoo>
