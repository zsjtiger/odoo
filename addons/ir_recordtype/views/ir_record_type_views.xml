<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ir_record_type_list" model="ir.ui.view">
        <field name="name">ir.record.type.list</field>
        <field name="model">ir.record.type</field>
        <field name="arch" type="xml">
            <list string="Record Types">
                <field name="model_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="sequence" optional="show"/>
                <field name="parent_id" optional="hide"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ir_record_type_form" model="ir.ui.view">
        <field name="name">ir.record.type.form</field>
        <field name="model">ir.record.type</field>
        <field name="arch" type="xml">
            <form string="Record Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Chain head"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Permissions" name="permissions">
                            <field name="permission_ids">
                                <list editable="bottom">
                                    <field name="group_id"/>
                                    <field name="perm_read"/>
                                    <field name="perm_write"/>
                                    <field name="perm_create"/>
                                    <field name="perm_unlink"/>
                                </list>
                            </field>
                        </page>
                        <page string="Access Rows" name="access">
                            <field name="access_ids" readonly="1"/>
                        </page>
                        <page string="Menus" name="menus">
                            <field name="action_id" readonly="1"/>
                        </page>
                        <page string="Defaults" name="defaults">
                            <field name="default_ids">
                                <list editable="bottom">
                                    <field name="group_id"/>
                                    <field name="model_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ir_record_type" model="ir.actions.act_window">
        <field name="name">Record Types</field>
        <field name="res_model">ir.record.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ir_record_type" name="Record Types" parent="base.menu_custom"
              action="action_ir_record_type" sequence="95" groups="base.group_system"/>
</odoo>
