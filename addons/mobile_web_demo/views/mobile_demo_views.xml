<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================ demo line (one2many) ============================ -->
    <record id="mobile_demo_line_list" model="ir.ui.view">
        <field name="name">mobile.demo.line.list</field>
        <field name="model">mobile.demo.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date" class="mobile_date"/>
                <field name="name" class="mobile_title"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- ============================ demo item: list ============================ -->
    <record id="mobile_demo_item_list" model="ir.ui.view">
        <field name="name">mobile.demo.item.list</field>
        <field name="model">mobile.demo.item</field>
        <field name="arch" type="xml">
            <!-- default_order: 移动端列表的默认排序 -->
            <list default_order="sequence, id">
                <!-- 标题与角标/副标题/日期: 移动端卡片中的标记 -->
                <field name="name" class="mobile_title mobile_sortable mobile_filterable"/>
                <field name="state" widget="state_selection" class="mobile_badge mobile_filterable"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"
                       decoration-info="state == 'confirmed'"/>
                <field name="partner_id" class="mobile_subtitle mobile_filterable"/>
                <field name="date" class="mobile_date mobile_sortable mobile_filterable"/>
                <!-- 可排序 / 可筛选: 用 class 标记 mobile_sortable / mobile_filterable, 标记的列才可用 -->
                <field name="total_amount" class="mobile_sortable mobile_filterable"/>
                <field name="progress" widget="progressbar"/>
                <field name="priority" widget="priority"/>
                <field name="is_urgent"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="user_id"/>
                <field name="company_id"/>
                <field name="visit_datetime"/>
                <field name="qty"/>
                <field name="duration" widget="float_time"/>
                <field name="percentage" widget="percentage"/>
                <field name="color" widget="color"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
                <field name="website" widget="url"/>
                <field name="secret" widget="password"/>
                <field name="payload" widget="json"/>
                <field name="image" widget="image"/>
                <!-- 列表中隐藏的字段 -->
                <field name="code" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================ demo item: search ============================ -->
    <record id="mobile_demo_item_search" model="ir.ui.view">
        <field name="name">mobile.demo.item.search</field>
        <field name="model">mobile.demo.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="tag_ids"/>
                <filter name="urgent" string="Urgent" domain="[('is_urgent', '=', True)]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ============================ demo item: form ============================ -->
    <record id="mobile_demo_item_form" model="ir.ui.view">
        <field name="name">mobile.demo.item.form</field>
        <field name="model">mobile.demo.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                    <button name="action_demo" type="object" string="Demo button"/>
                </header>
                <sheet>
                    <field name="image" widget="image"/>

                    <group string="Basic info">
                        <field name="name" required="1" readonly="state == 'done'"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="priority" widget="priority"/>
                        <field name="visit_type" widget="radio"/>
                        <field name="category"/>
                        <field name="color" widget="color"/>
                        <field name="is_urgent"/>
                        <field name="urgent_reason" invisible="not is_urgent"/>
                        <field name="note_required" required="is_urgent"/>
                    </group>

                    <separator string="Numbers"/>
                    <group>
                        <field name="progress" widget="progressbar"/>
                        <field name="percentage" widget="percentage"/>
                        <field name="qty"/>
                        <field name="duration" widget="float_time"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount"/>
                        <field name="price"/>
                        <field name="total_amount" readonly="1"/>
                    </group>

                    <group string="Dates and relations">
                        <field name="date"/>
                        <field name="visit_datetime"/>
                        <field name="partner_id" placeholder="Search a partner by name"/>
                        <field name="region_id" widget="cascade"/>
                        <field name="company_id"/>
                        <field name="user_id"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>

                    <group string="Contact">
                        <field name="email" widget="email"/>
                        <field name="phone" widget="phone"/>
                        <field name="website" widget="url"/>
                        <field name="secret" widget="password"/>
                    </group>

                    <field name="keyinfo_ids" widget="one2many_form"/>

                    <notebook>
                        <page string="Lines" name="lines">
                            <field name="line_ids"/>
                        </page>
                        <page string="Timeline" name="timeline">
                            <field name="line_ids" widget="timeline"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="description"/>
                            <field name="notes"/>
                        </page>
                        <page string="Files" name="files">
                            <field name="attachment"/>
                            <field name="payload" widget="json"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================ key info: inline form lines ============================ -->
    <record id="mobile_demo_keyinfo_form" model="ir.ui.view">
        <field name="name">mobile.demo.keyinfo.form</field>
        <field name="model">mobile.demo.keyinfo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product"/>
                        <field name="key_info"/>
                        <field name="feedback"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================ demo item: kanban ============================ -->
    <record id="mobile_demo_item_kanban" model="ir.ui.view">
        <field name="name">mobile.demo.item.kanban</field>
        <field name="model">mobile.demo.item</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <field name="name" class="mobile_title"/>
                        <field name="state" widget="state_selection"/>
                        <field name="partner_id"/>
                        <field name="total_amount"/>
                        <field name="progress" widget="progressbar"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================ action and menu ============================ -->
    <record id="mobile_demo_item_action" model="ir.actions.act_window">
        <field name="name">Mobile Demo Items</field>
        <field name="res_model">mobile.demo.item</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p>Demo records that exercise every mobile list and form control.</p>
        </field>
    </record>

    <record id="mobile_demo_item_kanban_action" model="ir.actions.act_window">
        <field name="name">Mobile Demo Kanban</field>
        <field name="res_model">mobile.demo.item</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="mobile_demo_menu_root" name="Mobile Demo" sequence="90"/>
    <menuitem id="mobile_demo_menu_items" name="Demo Items" parent="mobile_demo_menu_root" action="mobile_demo_item_action" sequence="10"/>
    <menuitem id="mobile_demo_menu_kanban" name="Demo Kanban" parent="mobile_demo_menu_root" action="mobile_demo_item_kanban_action" sequence="20"/>
</odoo>
