<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="web_builder.ViewEditor">
  <div class="o_web_studio_editor_manager d-flex flex-row w-100 h-100" t-ref="this.rootRef">
      <InteractiveEditor
        t-if="this.viewEditorModel.mode === 'interactive'"
        rendererRef="this.viewRendererRef"
        editor="this.viewEditorModel.editorInfo.editor"
        editorContainerRef="this.rootRef"
        t-key="this.interactiveEditorKey"
        t-slot-scope="scope"
      >
        <t t-call="web_builder.ViewEditor.View" />
      </InteractiveEditor>

      <t t-else="">
        <ViewXmlEditor studioViewArch="this.viewEditorModel.studioViewArch" mainResourceId="this.viewEditorModel.view.id" defaultResourceId="this.viewEditorModel.studioViewId || this.viewEditorModel.view.id" onClose.bind="this.onXmlEditorClose" onSave.bind="this.onSaveXml"/>
        <t t-call="web_builder.ViewEditor.View" />
      </t>
  </div>
</t>

<t t-name="web_builder.ViewEditor.View">
  <div t-attf-class="o_web_studio_view_renderer overflow-auto h-100 pe-auto {{ this.isMobile ? 'o_web_studio_device_mobile o_web_studio_mobile_split' : '' }}" t-ref="this.viewRendererRef">
    <div t-if="this.isMobile" class="o_web_studio_phone_preview">
      <div class="o_web_studio_phone_frame">
        <iframe class="o_web_studio_phone_iframe" title="Mobile preview" t-att-src="this.previewUrl" t-key="this.preview.key"/>
      </div>
      <div class="small text-muted text-center mt-1">Mobile preview</div>
    </div>
    <div class="o_web_studio_canvas_column">
      <div t-if="this.isMobile" class="o_web_studio_mobile_titlebar">
        <t t-out="this.studio.editedAction?.name"/>
      </div>
      <StudioView
        t-props="this.viewEditorModel.studioViewProps"
        t-key="this.viewEditorModel.studioViewKey"
        autoClick="scope and scope.autoClick"
      />
      <div t-if="this.isMobile" class="o_web_studio_mobile_footer">
        <button type="button" class="btn btn-secondary" tabindex="-1">Discard</button>
        <button type="button" class="btn btn-primary" tabindex="-1">Save</button>
      </div>
      <div t-if="this.isMobile" class="small text-muted mt-2">
        On mobile, the header buttons show only on saved records; a new record shows none.
      </div>
    </div>
  </div>
</t>

</templates>
